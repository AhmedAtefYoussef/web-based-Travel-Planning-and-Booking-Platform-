# Copy to backend/.env and fill in locally. Never commit real values.
# Validated at boot by backend/src/config/env.schema.ts (startup fails fast).

# development | test | production (default development)
NODE_ENV=
# HTTP port (default 3000)
PORT=

# Required
MONGODB_URI=
# Required, at least 32 characters
JWT_SECRET=
# Durations like 15m, 7d (defaults 15m / 7d)
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=
# Minutes of inactivity before the session ends (default 30)
SESSION_IDLE_MINUTES=

# ISO 4217 code for all prices, payments and refunds (default USD)
PLATFORM_CURRENCY=
# true behind HTTPS (default false)
COOKIE_SECURE=

# Stripe test mode; required when NODE_ENV=production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Exchange-rate API
FX_API_KEY=
FX_API_BASE_URL=https://api.fxratesapi.com

# Local folder for uploaded images (default ./uploads)
UPLOAD_DIR=

# Used only by the admin seed script
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Temporary x-dev-* header auth for local Swagger testing; never true in production
DEV_AUTH_ENABLED=false
